# ---- Database ----------------------------------------------------------
# Supabase: Project Settings -> Database -> Connection string -> URI
# Use the SESSION POOLER string (port 5432), not the transaction pooler.
# pgvector index builds and SET LOCAL for RLS both need session-level state.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ---- Models ------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
INTENT_MODEL=claude-haiku-4-5-20251001
NARRATION_MODEL=claude-sonnet-4-6

# Anthropic does not provide an embeddings endpoint. A separate provider is
# required. Voyage is the documented recommendation for Claude pairings.
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=pa-...
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIM=1024

# ---- Gateway -----------------------------------------------------------
PORT=8080
NODE_ENV=production
CONSOLE_ORIGIN=https://algivo.thinkvisor.io
JWT_SECRET=change-me-32-bytes-minimum

# ---- Email -------------------------------------------------------------
# Provider: smtp | resend | postmark | sendgrid | console
# 'console' prints to stdout and never sends - correct for local development.
EMAIL_PROVIDER=smtp
EMAIL_FROM=Algivo <no-reply@yourdomain.com>
EMAIL_REPLY_TO=support@yourdomain.com

# SMTP works with any host - Zoho, Google Workspace, SES SMTP, Mailgun.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Or pick one HTTP provider instead
RESEND_API_KEY=
POSTMARK_TOKEN=
POSTMARK_STREAM=outbound
SENDGRID_API_KEY=

# ---- Billing -----------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ---- Tuning ------------------------------------------------------------
SFTP_ROOT=/srv/algivo/sftp
INGEST_POLL_MS=15000
EMBED_BATCH=128
EMBED_IDLE_MS=5000
BOOTSTRAP_SECRET=change-me

CANDIDATE_LIMIT=200
RESULT_FLOOR=8
QUERY_CACHE_TTL_SECONDS=3600
TOKEN_TTL_MINUTES=30
